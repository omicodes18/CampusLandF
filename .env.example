# Flask Environment Configuration
# Copy this file to .env for local development: cp .env.example .env

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5001

# Secret Key for session signing and cryptographic operations
# Generate a secure key with: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Database Configuration (defaults to instance/lost_and_found.db)
DATABASE=instance/lost_and_found.db

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
